# autoviz Environment Variables

# === Project ===
PROJECT_NAME=autoviz
DEBUG=true
ENVIRONMENT=local

# === AI Agent (DeepSeek) ===
# Get an API key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# Model to use: https://api-docs.deepseek.com/quick_start/pricing
# deepseek-chat (fast, general) or deepseek-reasoner (slower, stronger reasoning)
AI_MODEL=deepseek-chat
# Base URL is fixed in code (https://api.deepseek.com/v1); this is informational only.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_TEMPERATURE=0.3
# Local dev only: set true when a TLS-intercepting proxy causes CERTIFICATE_VERIFY_FAILED.
# This disables certificate verification for DeepSeek (httpx) and Modal (grpclib).
DISABLE_SSL_VERIFY=false

# === Modal Sandbox (code execution) ===
# Get credentials at https://modal.com
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret
MODAL_APP_NAME=autoviz

# === Visualization settings (optional) ===
VIZ_TARGET_CHARTS=10
VIZ_CONCURRENCY=5

# === PostgreSQL + pgvector (optional semantic search) ===
# Leave DATABASE_URL empty to disable persistence/search.
# Docker: docker compose up -d  (uses pgvector/pgvector:pg16 on port 5433)
DATABASE_URL=
# Example for the bundled docker-compose:
# DATABASE_URL=postgresql://autoviz:autoviz@127.0.0.1:5433/autoviz
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_DEVICE=cpu
RAG_TOP_K=5
# Two-stage retrieval: pgvector recall -> CrossEncoder rerank.
RAG_RECALL_K=20
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DEVICE=cpu
# Optional HuggingFace mirror for model downloads (China):
# HF_ENDPOINT=https://hf-mirror.com
